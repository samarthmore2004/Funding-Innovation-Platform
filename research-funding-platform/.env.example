# Copy to .env (repository root) and adjust. Never commit the real .env file.

# --- Core -------------------------------------------------------------------------------------------------
ENVIRONMENT=development
# Generate a strong value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------------------------------------
# Local development default (no server needed):
DATABASE_URL=sqlite:///./rfip.db
# PostgreSQL example (Docker Compose builds this automatically from the POSTGRES_* values below):
# DATABASE_URL=postgresql+psycopg://rfip:your-password@localhost:5432/rfip
POSTGRES_DB=rfip
POSTGRES_USER=rfip
POSTGRES_PASSWORD=change-me-local-only

# --- Frontend / CORS --------------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Demo data (local demonstrations only; set SEED_DEMO_USERS=false in production) ----------------------
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=Demo@2026

# --- Background jobs --------------------------------------------------------------------------------------
ENABLE_SCHEDULER=true
ALERTS_INTERVAL_MINUTES=360
GRANTSGOV_SYNC_ENABLED=false
GRANTSGOV_SYNC_INTERVAL_MINUTES=1440

# --- External data sources (all optional; the app works offline from the bundled snapshots) --------------
EXTERNAL_APIS_ENABLED=true
HTTP_TIMEOUT_SECONDS=20
# Free personal key raises the OpenAlex daily quota: https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=
# Free key enables live USPTO patent search: https://patentsview.org/
PATENTSVIEW_API_KEY=

# --- Optional social login (OAuth2 authorization-code flow) ----------------------------------------------
# Redirect URI to register with the provider: {OAUTH_REDIRECT_BASE_URL}/api/auth/oauth/<provider>/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
